address_phase:
    set 6..7 L,
    set 12 3,
    set 13 7,
    set 8..11 O8..O11,
    set 14..15 L,
    set 16..23 8..15,
    set 24..25 L,
    read 16

address_trajectory:
    set 8..11 L8..L11,
    set 14..15 L,
    set 16..19 O8..O11,
    set 20..21 O12..O13,
    set 22..25 L8..L11,
    set 26..31 L

emit:
    set 0..5 L0..L5,
    set 6..7 L,
    set 12 3,
    set 13 7,
    set 8..11 O8..O11,
    set 14..15 L,
    set 16..23 8..15,
    set 24..25 L,
    read 16,
    write 8,
    jmp address_trajectory
