# Issue #9 candidate. One prime, then exactly two bundles per output.
# Input pair is [middle, current]. Save middle signs BEFORE read 16 advances
# the input register. O12..13 carry that hint to the trajectory address bundle.
# O8..11 retain endpoint phase across every pair and cyclic DMA ring wrap.
# LUT low 6 bits = final DAC; high bits 8..11 = phase4 of raw index 0..255.
# Fixed calibration: current-minus-previous, gain 2, pedestal 20.
# Generated uniform geometry prior; independent RF/hardware validation pending.
cfg prefetch true
cfg eof_on upstream
cfg trailing_bytes 9
cfg lut_width_bits 16
lut 532 776 1024 1024 1024 1024 1024 1024 3098 3135 3135 3135 3133 3128 3373 3616 276 520 768 768 769 768 768 768 3098 3391 3391 3391 3391 3384 3629 3872 20 265 514 513 769 769 769 769 3354 3329 3329 3329 3587 3640 3885 3872 20 264 512 512 572 830 830 830 3354 3390 3390 3646 3645 3639 3884 32 32 276 263 512 512 512 512 768 3329 3617 3647 3647 3646 3903 3896 44 32 276 263 256 513 512 512 512 3645 3617 3647 3647 3903 3903 3896 44 31 276 263 256 512 512 512 512 3584 3617 3584 3584 3842 3903 3896 44 32 277 263 256 256 512 512 512 3584 3617 3647 3903 3903 3903 3896 44 2092 2080 1812 1799 1792 1536 1536 1536 2561 2560 2587 2367 2366 2367 2367 2104 2092 1824 1812 1799 1538 1536 1536 1536 2621 2623 2587 2623 2367 2367 2367 2104 2091 1824 1812 1799 1536 1536 1536 1536 2560 2560 2587 2560 2306 2367 2367 2104 2092 1824 1812 1543 1536 1536 1536 1280 2816 2560 2587 2623 2623 2367 2367 2104 2103 1836 1568 1556 1544 1281 1280 1280 2817 2816 2816 2590 2622 2623 2367 2111 2103 1836 1568 1556 1289 1281 1280 1280 2877 2879 2879 2846 2623 2623 2367 2367 1846 1580 1312 1300 1288 1281 1280 1280 2816 2816 2816 2846 2818 2879 2623 2367 1591 1324 1312 1045 1032 1025 1024 1024 3072 3072 3072 3102 3135 2879 2879 2623 62 55 44 32 20 7 0 0 1 0 0 0 37 63 63 63 61 54 43 31 20 7 0 0 60 62 62 62 37 62 62 62 61 55 44 32 20 7 0 0 0 0 0 0 37 63 63 63 3 55 44 32 20 8 2 1 1 1 1 1 37 1 1 1 63 63 56 44 32 20 7 0 1 0 0 0 62 32 63 63 63 63 56 44 32 21 7 0 0 0 0 0 0 32 63 63 62 63 56 44 32 20 7 0 0 0 0 0 2 32 63 63 1 63 56 44 32 20 7 0 0 0 0 0 0 32 0 0 63 63 63 56 45 32 20 8 2 0 0 0 62 63 26 63 63 63 63 56 45 32 20 8 1 0 0 0 0 0 26 63 62 63 63 56 45 32 20 8 1 0 0 0 2 0 26 63 1 63 63 56 44 32 20 8 1 0 0 0 0 0 26 0 63 63 63 63 56 44 32 20 9 0 0 0 62 63 63 32 63 63 63 63 56 44 32 21 8 0 0 0 0 0 0 32 62 63 63 63 56 44 32 20 8 0 0 0 2 0 0 32 1 63 63 63 55 44 32 20 8 0 0 0 0 0 0 32 37 62 62 62 61 54 42 31 20 7 0 0 61 62 62 62 37 2 2 2 3 55 43 32 20 8 2 2 2 2 2 2 37 63 63 63 63 55 43 32 20 7 0 0 2 0 0 0 37 63 63 63