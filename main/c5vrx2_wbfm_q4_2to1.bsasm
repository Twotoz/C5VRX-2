# Continuous MODEM_DIAG Q4/I4 -> adjacent WBFM -> real 2:1 boxcar.
#
# PARLIO RX packs one sample as Q[9:6] in bits 3:0 and I[9:6] in bits
# 7:4.  Every acquired complex sample participates in an adjacent phase
# difference.  Two real discriminator results are averaged only after FM,
# producing one six-bit CVBS DAC code for every two 40-MS/s input samples.
#
# O6..O10 retain the compact previous IQ state across every output and GDMA
# descriptor wrap. Odd/even samples alternate Q3/I2 and Q2/I3 quantizers;
# LUT address bit 10 identifies the current mapping.

cfg prefetch false
cfg eof_on downstream
cfg trailing_bytes 0
cfg lut_width_bits 8

init:
    # read 8 places the byte in I56..I63. Prime previous as Q2/I3.
    read 8,
    set 6..7 58..59,
    set 8..10 61..63,
    LDCTDAL 40

sample1:
    # Current Q3/I2, previous Q2/I3, LUT bank 0.
    read 8,
    set 6..8 57..59,
    set 9..10 62..63,
    set 21..23 57..59,
    set 24..25 62..63,
    set 26..30 O6..O10,
    set 31 L,
    ADDCTIAL

sample2:
    # Current Q2/I3, previous Q3/I2, LUT bank 1.
    read 8,
    set 6..7 58..59,
    set 8..10 61..63,
    set 21..22 58..59,
    set 23..25 61..63,
    set 26..30 O6..O10,
    set 31 H,
    ADDCTIAL

emit:
    # Divide the two-term real accumulator by two. Upper output bits stay 0.
    set 0..5 A1..A6,
    set 6..7 L,
    write 8,
    LDCTDAL 40
    jmp sample1
