# Continuous packed Q4/I4 -> full-byte phase LUT -> adjacent WBFM -> real /2.
#
# Each input byte is Q[9:6] in bits 3:0 and I[9:6] in bits 7:4. The 16-bit
# LUT maps the complete byte to:
#
#   L0..L7   = calibrated absolute phase
#   L8..L15  = pedestal - calibrated absolute phase
#
# Adding the low byte for the current sample and the saved high byte for the
# previous sample gives pedestal + phase[n] - phase[n-1], modulo eight bits.
# Two genuine adjacent discriminator results are accumulated and only then
# averaged to one six-bit 20-MS/s CVBS sample.
#
# O8..O15 retains pedestal-phase[n-1] across every normal GDMA ring wrap.

cfg prefetch true
cfg eof_on downstream
cfg trailing_bytes 0
cfg lut_width_bits 16

address1:
    # LUT address bits are output bits 31..22 from this cycle. Preserve the
    # previous biased-negative phase in O8..O15 while prefetching sample 2.
    # Reset A here once per pair, avoiding a ninth C5 instruction.
    set 8..15 O8..O15,
    set 22..29 56..63,
    set 30..31 L,
    read 8,
    LDCTDAL 0

add_current1:
    set 0..7 L8..L15,
    set 8..15 O8..O15,
    set 16..23 L0..L7,
    ADDCTIAL

add_previous1:
    set 0..7 O0..O7,
    set 16..23 O8..O15,
    ADDCTIAL

address2:
    # Sample 1 is now the previous sample. Address sample 2 and prefetch the
    # first byte of the next pair.
    set 8..15 O0..O7,
    set 22..29 56..63,
    set 30..31 L,
    read 8

add_current2:
    set 0..7 L8..L15,
    set 8..15 O8..O15,
    set 16..23 L0..L7,
    ADDCTIAL

add_previous2:
    set 0..7 O0..O7,
    set 16..23 O8..O15,
    ADDCTIAL

emit:
    # Divide the two-result real boxcar by two and retain sample 2's phase
    # state in O8..O15 across the write cycle.
    set 0..5 A1..A6,
    set 6..7 L,
    set 8..15 O0..O7,
    write 8,
    jmp address1
