# Continuous packed C5 Q10/I10 -> adjacent-sample WBFM -> real 4:1 boxcar.
#
# Every input IQ word participates in the discriminator.  O6..O9 persist a
# compact previous-IQ state across output groups and across the cyclic GDMA
# descriptor boundary.  Counter A accumulates four signed adjacent phase
# differences around four times DAC code 20, then A2..A7 perform the real
# four-sample boxcar/decimation. Calibration offset is carried by the LUT.

cfg prefetch true
cfg eof_on downstream
cfg trailing_bytes 0
cfg lut_width_bits 8

init:
    # Prime previous-IQ from the first word.  The first group consequently
    # contains three genuine intervals and one zero transient; no later group
    # or physical SRAM wrap resets this state.
    set 6..7 8..9,
    set 8..9 18..19,
    set 24..25 8..9,
    set 26..27 18..19,
    set 28..29 8..9,
    set 30..31 18..19,
    read 32,
    LDCTDAL 80

sample1:
    set 6..7 8..9,
    set 8..9 18..19,
    set 16..17 8..9,
    set 18..19 18..19,
    set 24..27 O6..O9,
    set 28..29 8..9,
    set 30..31 18..19,
    read 32,
    ADDCTIAL

sample2:
    set 6..7 8..9,
    set 8..9 18..19,
    set 16..17 8..9,
    set 18..19 18..19,
    set 24..27 O6..O9,
    set 28..29 8..9,
    set 30..31 18..19,
    read 32,
    ADDCTIAL

sample3:
    set 6..7 8..9,
    set 8..9 18..19,
    set 16..17 8..9,
    set 18..19 18..19,
    set 24..27 O6..O9,
    set 28..29 8..9,
    set 30..31 18..19,
    read 32,
    ADDCTIAL

sample4:
    set 6..7 8..9,
    set 8..9 18..19,
    set 16..17 8..9,
    set 18..19 18..19,
    set 24..27 O6..O9,
    set 28..29 8..9,
    set 30..31 18..19,
    read 32,
    ADDCTIAL

emit:
    set 0..5 A2..A7,
    set 6..9 O6..O9,
    set 21..31 O21..O31,
    write 8,
    LDCTDAL 80

loop:
    jmp sample1
