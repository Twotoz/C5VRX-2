# Packed C5 Q10/I10 -> donor-accurate six-bit phase delta, decimate 4:1.
# O0..O5 drive the six-resistor DAC; zero deviation is calibrated code 15.

cfg prefetch true
# The 64 KiB input GDMA descriptor is cyclic. Do not terminate/reset the
# discriminator on its per-block EOF; PARLIO loop mode intentionally has no
# downstream EOF, so IQ -> phase delta -> DAC remains continuous over rearms.
cfg eof_on downstream
cfg trailing_bytes 0
cfg lut_width_bits 16

init:
    LDCTDBL 15

sample_address:
    set 22..26 5..9,
    set 27..31 15..19,
    read 32,
    jmp phase_add

phase_add:
    set 0..5 L8..L13,
    set 16..21 L0..L5,
    read 32,
    ADDCTIBL

emit_and_remember:
    set 0..5 B0..B5,
    set 16..21 O0..O5,
    read 32,
    write 8,
    LDCTIBL

decimate_fourth:
    read 32,
    jmp sample_address
